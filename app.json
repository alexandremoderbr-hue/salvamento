{
  "expo": {
    "name": "FLUX",
    "slug": "levy-cell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/flux-logo.png",
    "scheme": "levycell",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.levycell"
    },
    "android": {
      "package": "com.levycell",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/flux-logo.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/flux-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/flux-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Flux to use Face ID to unlock your account."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Flux acessa suas fotos para você escolher a logo e o banner do aplicativo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1d860206-2841-46ef-90cb-843a0146caf1"
      }
    },
    "owner": "dedireitaateofim"
  }
}
